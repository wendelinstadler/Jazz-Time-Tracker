{
  "manifest_version": 3,
  "name": "Jazz Time Tracker",
  "description": "This extension enables automatic time tracking and compliance checks for Jazz.",
  "version": "2.1.0",
  "permissions": [
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://jazz.coop.ch/mobile/*",
    "https://jazz.hs.coop.ch/mobile/*",
    "https://jazz.coop.ch/client/mobile/*",
    "https://jazz.hs.coop.ch/client/mobile/*"
  ],
  "action": {
    "default_popup": "dist/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "scripts": [
      "dist/core.js",
      "dist/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://jazz.coop.ch/mobile/*",
        "https://jazz.hs.coop.ch/mobile/*",
        "https://jazz.coop.ch/client/mobile/*",
        "https://jazz.hs.coop.ch/client/mobile/*"
      ],
      "js": [
        "dist/core.js",
        "dist/main.js"
      ]
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jazz-time-tracker@coop.ch",
      "strict_min_version": "121.0"
    }
  }
}
